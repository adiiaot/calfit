EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_DEEPGRAM_KEY=your-deepgram-api-key-here
EXPO_PUBLIC_NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
EXPO_PUBLIC_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── NVIDIA MODELS ──────────────────────────────────────────────
# Current (good quality, slower): meta/llama-3.1-70b-instruct
# Faster alternatives (try these for speed):
#   meta/llama-3.2-3b-instruct     — Very fast, good for chat
#   mistralai/mistral-7b-instruct  — Fast, strong general purpose
#   google/gemma-2-2b-it           — Ultra fast, compact
#   microsoft/phi-3-mini-4k-instruct — Fast, good instruction following
EXPO_PUBLIC_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Vision model for food scanner
#   meta/llama-3.2-90b-vision-instruct  — Good quality, slower
#   microsoft/phi-3-vision-128k-instruct — Faster vision model
EXPO_PUBLIC_NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
