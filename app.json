{
  "expo": {
    "name": "CalFit",
    "slug": "calfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "com.aotnetwork.calfit",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aotnetwork.calfit",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "CalFit uses motion data to count your steps automatically.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aotnetwork.calfit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION",
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
      },
      "description": "CalFit - AI Fitness & Nutrition Coach"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0DAE6C",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CalFit needs camera access to scan food and log your meals.",
          "microphonePermission": "CalFit needs microphone access for voice input with the AI Coach."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CalFit needs access to your photos to set your avatar."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*",
      "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*.ttf"
    ],
    "extra": {
      "eas": {
        "projectId": "2da67313-11c7-433d-9cd4-b5e725dce13c"
      }
    }
  }
}
