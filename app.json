{
  "expo": {
    "name": "CalFit",
    "slug": "calfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "com.aotnetwork.calfit",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aotnetwork.calfit",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "CalFit uses motion data to count your steps automatically.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aotnetwork.com",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": [
        "ACTIVITY_RECOGNITION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0DAE6C",
          "sounds": []
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*",
      "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*.ttf"
    ],
    "extra": {
      "eas": {
        "projectId": "2da67313-11c7-433d-9cd4-b5e725dce13c"
      }
    }
  }
}
