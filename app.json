{
  "expo": {
    "name": "CalFit",
    "slug": "calfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigcutstore.calfit",
      "usesAppleSignIn": true,
      "infoPlist": {
  "NSMotionUsageDescription": "CalFit uses motion data to count your steps automatically."
}
      
    },
    "android": {
      "package": "com.bigcutstore.calfit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080A0F"
      },
      "permissions": ["ACTIVITY_RECOGNITION"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "assetBundlePatterns": [
      "**/*",
      "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/*.ttf"
    ]
  }
}